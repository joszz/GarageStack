# Copy this file to .env.demo and run:
#   docker compose --env-file .env.demo -f docker-compose.demo.yml up --build
#
# No SAIC credentials, no database, no MQTT required.

# ── Demo ──────────────────────────────────────────────────────────────────────
# docker-compose.demo.yml always turns demo mode on, so DEMO_MODE is not read from here.
# true adds a second car, an MG HS PHEV, next to the ZS EV, to try the car picker.
DEMO_SECOND_VEHICLE=false
# false leaves out the RDW card, the licence plate field and the RDW notifications.
# The demo's stand-in RDW asks nothing upstream.
RDW_ENABLED=true

# ── Logging ───────────────────────────────────────────────────────────────────
# true logs debug detail from the API.
DEBUG_LOGS=false

# ── Rate limit ────────────────────────────────────────────────────────────────
# Requests per minute from one address. High, so the browser tests can drive several
# pages at once.
RATE_LIMIT_GLOBAL_PER_MINUTE=2000

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_USERNAME=demo
AUTH_PASSWORD=demo

# ── Ports ─────────────────────────────────────────────────────────────────────
FRONTEND_PORT=8080
API_PORT=5001

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:8080
