# Copy this file to .env.demo and run:
#   docker compose -f docker-compose.demo.yml up --build
#
# No SAIC credentials, no database, no MQTT required.

# ── Demo toggle ───────────────────────────────────────────────────────────────
DEMO_MODE=true

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_USERNAME=demo
AUTH_PASSWORD=demo

# ── Ports ─────────────────────────────────────────────────────────────────────
FRONTEND_PORT=8080
API_PORT=5001

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:8080
