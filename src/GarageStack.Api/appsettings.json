{
  "Cors": {
    "Origins": ["http://localhost:80"]
  },
  "OpenChargeMap": {
    "ApiKey": ""
  },
  "Overpass": {
    "BaseUrl": "https://overpass-api.de/api/interpreter"
  },
  "Geocoding": {
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "Enabled": "true"
  },
  "MapMatching": {
    "BaseUrl": "https://valhalla1.openstreetmap.de",
    "Enabled": "true"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
