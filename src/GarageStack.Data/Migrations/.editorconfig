# EF Core migrations are generated by the tooling in its own style and are never hand-edited
# beyond the occasional raw SQL statement, so the repository's style rules do not apply here.
# Kept in this folder (not as a path section in the root .editorconfig) so it matches no matter
# where the project is copied, including the /src layout the Dockerfiles use.
[*.cs]
generated_code = true
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0161.severity = none
