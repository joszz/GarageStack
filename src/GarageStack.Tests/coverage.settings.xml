<?xml version="1.0" encoding="utf-8"?>
<!--
  What counts towards the backend's coverage figure (dotnet test -coverage-settings). Generated code
  is left out: the EF Core migrations and the model snapshot are thousands of lines no test calls,
  and they pulled the figure down to a fraction of what the hand-written code has.
-->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*GarageStack\.(Api|Core|Data|Worker)\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[\/]Migrations[\/].*</Source>
        <Source>.*[\/]obj[\/].*</Source>
      </Exclude>
    </Sources>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
