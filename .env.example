# Copy this file to .env and fill in real values - never commit .env

# ── SAIC / MG iSMART ────────────────────────────────────────────────────────
# Must be the vehicle owner account. Shared/secondary accounts lack the write
# permissions required to register alarm switches and will get error 1100003.
# Use a separate account for the MG iSmart phone app to avoid session conflicts.
SAIC_USER=your_mg_account@example.com
SAIC_PASSWORD=your_mg_account_password
# Region the car is registered in: eu (default), au, or tr -- automatically mapped
# to the right API endpoint. For any other region, set SAIC_REST_URI below directly
# to your gateway's endpoint instead.
SAIC_REGION=eu
# Optional override, only needed for a region not listed above.
# SAIC_REST_URI=https://gateway-mg-eu.soimt.com/api.app/v1/

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# To use your own existing Postgres server set POSTGRES_HOST to its address and
# remove (or don't start) the bundled postgres profile:
#   docker compose up                        <- external postgres
#   docker compose --profile bundled-postgres up   <- bundled postgres
#
# The bundled service creates the database automatically; on an external server
# you must create the database and user yourself first.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=garagestack
POSTGRES_USER=garagestack
# Required when using the bundled postgres profile (docker compose refuses to
# start otherwise). Generate a strong password: openssl rand -hex 32
POSTGRES_PASSWORD=

# ── MQTT ────────────────────────────────────────────────────────────────────
# Defaults to the bundled Mosquitto broker running inside Docker Compose.
# Set MQTT_HOST / MQTT_PORT to point at your own broker instead.
MQTT_HOST=mosquitto
MQTT_PORT=1883
# Host port Mosquitto is published on (only relevant for the bundled broker).
MQTT_EXTERNAL_PORT=1883
# Interface MQTT_EXTERNAL_PORT is bound to. Defaults to loopback-only; set to
# 0.0.0.0 (or a specific LAN address) only if you need to reach the broker
# from other devices, and set MQTT_BROKER_USERNAME/PASSWORD below first.
MQTT_BIND_ADDRESS=127.0.0.1
# Dedicated broker credentials -- decoupled from your SAIC/MG account so a
# LAN-exposed broker does not leak your cloud account password.
# Required when using the bundled Mosquitto (docker compose refuses to start
# otherwise). Generate a strong password: openssl rand -hex 32
MQTT_BROKER_USERNAME=garagestack
MQTT_BROKER_PASSWORD=

# ── Home Assistant ───────────────────────────────────────────────────────────
# Optional second broker login for Home Assistant's MQTT integration. The SAIC
# gateway already publishes Home Assistant discovery, so the car appears in HA
# automatically. This user can only use the saic/# and homeassistant/# topics.
# Leave HA_MQTT_USERNAME empty to skip it. Full guide: HOME_ASSISTANT.md
# Generate the password with: openssl rand -hex 32
# HA_MQTT_USERNAME=homeassistant
# HA_MQTT_PASSWORD=

# ── Ports ───────────────────────────────────────────────────────────────────
# Host port for the frontend (nginx). Use 8080 by default to avoid clashing
# with existing reverse proxies/web servers that already bind port 80.
FRONTEND_PORT=8080
# Host port for the API. The API is bound to 127.0.0.1 by default, so it is
# reachable only from the local machine. The frontend proxies /api internally
# and does not require direct host access. Remove the 127.0.0.1: prefix in
# docker-compose.yml only if you intentionally want the API reachable from LAN.
API_PORT=5000

# ── CORS ────────────────────────────────────────────────────────────────────
# The URL your browser uses to reach the frontend -- must match exactly including
# the port. This MUST be the address you type in the browser, not the server's
# internal address. If you access from another device on the LAN, use the
# server's LAN IP or hostname (e.g. http://192.168.1.100:8080), NOT localhost.
# Using localhost here blocks login from any device other than the server itself.
# Add more origins by setting Cors__Origins__1 etc. in docker-compose.
CORS_ORIGIN=http://localhost:8080

# ── Authentication ───────────────────────────────────────────────────────────
# GarageStack signs users in either through an OpenID Connect provider (recommended) or with a
# single built-in username and password. Configuring OIDC below disables the password login,
# unless AUTH_PASSWORD_LOGIN_ENABLED keeps it on.
# Full setup guide, with provider-specific examples: AUTHENTICATION.md

# Built-in password login. Leave both empty to reuse the MG account credentials above.
# AUTH_USERNAME=
# AUTH_PASSWORD=

# The password login switches itself off as soon as OIDC is configured below. Set this to true
# to keep it available alongside single sign-on, e.g. as break-glass access for when your
# identity provider is unreachable. Give it a strong, dedicated password if you do.
# AUTH_PASSWORD_LOGIN_ENABLED=true

# Defaults to false so plain-HTTP quick-start installs work out of the box.
# Set to true when the app is served over HTTPS or behind a TLS-terminating proxy.
# AUTH_COOKIE_SECURE=true

# How long a single sign-on session lasts before the provider is consulted again (hours).
# Signing in again is usually invisible while the provider's own session is still valid.
# AUTH_SESSION_LIFETIME_HOURS=168

# ── OpenID Connect (single sign-on) ──────────────────────────────────────────
# Issuer URL of your provider -- the URL its /.well-known/openid-configuration sits under, e.g.
# https://auth.example.com/application/o/garagestack/ (Authentik),
# https://auth.example.com (Authelia, Pocket ID),
# https://auth.example.com/realms/<realm> (Keycloak).
# Setting this switches GarageStack to OIDC and turns the password login off (unless
# AUTH_PASSWORD_LOGIN_ENABLED=true above).
OIDC_AUTHORITY=
OIDC_CLIENT_ID=
# Leave empty for a public client (PKCE only, no client secret).
OIDC_CLIENT_SECRET=

# Redirect URI to register at your provider:
#   <the URL you open GarageStack on>/api/auth/oidc/callback
# GarageStack works this out from the request itself. Only set OIDC_REDIRECT_URI when it
# cannot -- several chained reverse proxies, for instance. Must end in the same path.
# OIDC_REDIRECT_URI=

# Name shown on the sign-in button ("Sign in with ...").
OIDC_PROVIDER_NAME=SSO
# Skip the login page and go straight to the provider.
OIDC_AUTO_LOGIN=false
# Scopes to request. Add the one carrying group membership if your provider needs it.
OIDC_SCOPES=openid profile email

# Who may sign in. Leave both empty ONLY if the provider itself already restricts this
# application -- otherwise every account it accepts can sign in and control your car.
OIDC_ALLOWED_GROUPS=
OIDC_ALLOWED_EMAILS=
# Claim the groups above are matched against.
# OIDC_GROUPS_CLAIM=groups

# Set to false only for a provider served over plain HTTP on your LAN.
# OIDC_REQUIRE_HTTPS_METADATA=true

# ── Version ─────────────────────────────────────────────────────────────────
# Version shown in the UI footer and stamped into the API/Worker, only used when building
# from source. Published images already carry it. A source build has no git history to read
# it from, so pass it in when building, straight from your checkout:
#   APP_VERSION=$(git describe --tags) docker compose up -d --build
# or set it here (a leading "v" is fine). Defaults to 0.0.0-local.
# APP_VERSION=v0.5.0

# ── Logging ──────────────────────────────────────────────────────────────────
# Set to true to enable Debug-level logs (api + worker). Useful when diagnosing
# MQTT mapping gaps or unexpected behaviour. Keep false in production.
DEBUG_LOGS=false

# ── VAPID (push notifications) ───────────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# Leave blank to disable push notifications (the app still works without them).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Language of the push notification texts ("Engine started", "Door left open", ...): en or nl.
# Notifications are written by the background worker, which has no browser to take a
# language from, so unlike the web UI this is a per-deployment setting.
NOTIFICATION_LANGUAGE=en

# ── Homepage widget ───────────────────────────────────────────────────────────
# Static API key for the unauthenticated /api/widget/{vin}/status endpoint used
# by the gethomepage.dev Custom API widget. Leave empty to disable the endpoint.
# Generate with: openssl rand -base64 32
WIDGET_API_KEY=

# ── Open Charge Map ───────────────────────────────────────────────────────────
# API key for the Open Charge Map charging station overlay on the map view.
# Free to obtain at https://openchargemap.org/site/develop
# Leave empty to disable the charging stations feature (the map still works).
OPENCHARGEMAP_API_KEY=

# ── Overpass API (OpenStreetMap POI data) ─────────────────────────────────────
# The Overpass API is used for fuel station and motorway service area overlays on
# the map. No API key is required (free/FOSS data). The default public endpoint
# is used automatically. Override only if you self-host an Overpass instance.
# OVERPASS__BASEURL=https://overpass-api.de/api/interpreter

# ── Tyre pressure thresholds ───────────────────────────────────────────────────
# Colour-code thresholds (bar) for the Overview diagram's tyre dots and for
# low/high tyre-pressure notifications. Defaults suit ~2.5 bar passenger cars --
# override with your vehicle's placarded pressure, e.g. TYRE_PRESSURE_GOOD_BAR=2.55.
TYRE_PRESSURE_LOW_BAR=2.2
TYRE_PRESSURE_GOOD_BAR=2.6
TYRE_PRESSURE_HIGH_BAR=3.2
