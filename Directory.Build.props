<Project>

  <!-- Settings every project under src/ shares. Per-project files only add what differs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Needed for the unused-using check (IDE0005) to run as part of the build. CS1591 (missing
         XML comment on public member) is deliberately not enforced: comments are for the
         non-obvious, not for every public record. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- NuGet vulnerability audit findings stay visible as warnings but do not fail the build.
         Otherwise a newly published advisory would break every Docker and CI build overnight
         with no code change; Dependabot and the Trivy scans are what act on those. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <!-- BannedSymbols.txt: what production code must not call (the wall clock, so far). The tests
       may: they are where a fixed time is set up. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'GarageStack.Tests'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

</Project>
