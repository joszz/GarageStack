<Project>
  <!-- Central package management: every NuGet version lives here once, so the four projects
       cannot drift apart (EF Core in particular must match across Data, Api, Worker and Tests). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <!-- ASP.NET Core / hosting -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <!-- Referenced directly by the Api for its document transformers. Microsoft.AspNetCore.OpenApi 11
         needs [3.11.0, 4.0.0), so stay on the 3.x line. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.1" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="11.0.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="3.1.1" />
    <!-- Writes the badges and code samples endpoints declare into the OpenAPI document. Released
         together with Scalar.AspNetCore under the same version; keep the two equal. -->
    <PackageVersion Include="Scalar.AspNetCore.Microsoft" Version="3.1.1" />
    <!-- Entity Framework Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
    <!-- Messaging / push -->
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <PackageVersion Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="11.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="11.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Analyzers -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- Tests -->
    <!-- Coverage for Microsoft.Testing.Platform (global.json); coverlet.collector only plugs into VSTest. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
